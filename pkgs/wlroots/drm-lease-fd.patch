 static struct wlr_backend *attempt_drm_backend(struct wlr_backend *backend, struct wlr_session *session) {
 #if WLR_HAS_DRM_BACKEND
+	// A lessee is handed a DRM lease fd by its parent and must not enumerate
+	// or touch any other GPU: doing so would fight the lessor for DRM master.
+	const char *lease_fd_str = getenv("WLR_DRM_LEASE_FD");
+	if (lease_fd_str != NULL) {
+		char *endptr;
+		long lease_fd = strtol(lease_fd_str, &endptr, 10);
+		if (endptr == lease_fd_str || *endptr != '\0' || lease_fd < 0 || lease_fd > INT_MAX) {
+			wlr_log(WLR_ERROR, "Invalid WLR_DRM_LEASE_FD: '%s'", lease_fd_str);
+			return NULL;
+		}
+
+		wlr_log(WLR_INFO, "Using leased DRM fd %ld, skipping GPU enumeration", lease_fd);
+
+		struct wlr_device *dev = wlr_session_adopt_fd(session, (int)lease_fd);
+		if (dev == NULL) {
+			wlr_log(WLR_ERROR, "Failed to adopt leased DRM fd");
+			return NULL;
+		}
+
+		struct wlr_backend *leased = wlr_drm_backend_create(session, dev, NULL);
+		if (leased == NULL) {
+			wlr_log(WLR_ERROR, "Failed to create DRM backend on leased fd");
+			return NULL;
+		}
+
+		wlr_multi_backend_add(backend, leased);
+		// Deliberately no drm_backend_monitor_create(): a lessee must never
+		// adopt GPUs that appear later.
+		return leased;
+	}
