diff --git a/backend/session/session.c b/backend/session/session.c
index 8687743..faf10c2 100644
--- a/backend/session/session.c
+++ b/backend/session/session.c
@@ -369,9 +369,35 @@ error:
 	return NULL;
 }
 
+
+struct wlr_device *wlr_session_adopt_fd(struct wlr_session *session, int fd) {
+	struct wlr_device *dev = malloc(sizeof(*dev));
+	if (!dev) {
+		wlr_log_errno(WLR_ERROR, "Allocation failed");
+		return NULL;
+	}
+
+	struct stat st;
+	if (fstat(fd, &st) < 0) {
+		wlr_log_errno(WLR_ERROR, "Stat failed");
+		free(dev);
+		return NULL;
+	}
+
+	dev->fd = fd;
+	dev->dev = st.st_rdev;
+	// Not opened via libseat, so there is no device ID to close against.
+	dev->device_id = -1;
+	wl_signal_init(&dev->events.change);
+	wl_signal_init(&dev->events.remove);
+	wl_list_insert(&session->devices, &dev->link);
+
+	return dev;
+}
 void wlr_session_close_file(struct wlr_session *session,
 		struct wlr_device *dev) {
-	if (libseat_close_device(session->seat_handle, dev->device_id) == -1) {
+	if (dev->device_id != -1 &&
+			libseat_close_device(session->seat_handle, dev->device_id) == -1) {
 		wlr_log_errno(WLR_ERROR, "Failed to close device %d", dev->device_id);
 	}
 
