 void
+flatpak_proxy_set_talk_siblings (FlatpakProxy *proxy,
+                                 gboolean      talk_siblings)
+{
+  proxy->talk_siblings = talk_siblings;
+}
+
+static gboolean
+flatpak_proxy_is_sibling (FlatpakProxy *proxy,
+                          const char   *unique_id)
+{
+  GList *l;
+
+  for (l = proxy->clients; l != NULL; l = l->next)
+    {
+      FlatpakProxyClient *other = l->data;
+
+      if (g_strcmp0 (other->unique_id, unique_id) == 0)
+        return TRUE;
+    }
+
+  return FALSE;
+}
